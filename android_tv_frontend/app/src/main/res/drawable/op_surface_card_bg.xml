<?xml version="1.0" encoding="utf-8"?>
<!-- Ocean Professional surface card with rounded corners, subtle gradient, and focus shadow -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <gradient
                android:startColor="#1A2563EB"
                android:centerColor="#26222A"
                android:endColor="#33111827"
                android:angle="270"/>
            <stroke android:width="2dp" android:color="@color/op_secondary"/>
            <padding android:left="32dp" android:top="24dp" android:right="32dp" android:bottom="24dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <gradient
                android:startColor="#14111827"
                android:endColor="#22111827"
                android:angle="270"/>
            <stroke android:width="1dp" android:color="#332563EB"/>
            <padding android:left="32dp" android:top="24dp" android:right="32dp" android:bottom="24dp"/>
        </shape>
    </item>
</selector>
